{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-debug"
    },
    {
      "name": "windows-ninja",
      "displayName": "Windows x64 Debug (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-ninja",
      "configurePreset": "windows-ninja"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-ninja",
      "configurePreset": "windows-ninja",
      "output": { "outputOnFailure": true }
    }
  ]
}
